# Copy to server/.env and change before deploying.
PORT=4000
# Long random string used to sign login tokens. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (created automatically).
DATABASE_PATH=./data/freshtrack.db
# Days before expiry that a product counts as "expiring soon" (US-04).
EXPIRY_WARNING_DAYS=3
